# Where the SQLite database lives.
DB_PATH=./data/pilot.db

# Where each LinkedIn account's persistent Chromium profile lives.
# One directory per account. Treat these like credentials — they hold the session.
PROFILES_DIR=./data/profiles

# HTTP control API + dashboard.
PORT=4310
# Any non-empty value is required as `Authorization: Bearer <token>` on every
# /api call. Leave blank ONLY if you are on a machine nobody else can reach.
API_TOKEN=

# AI layer. Leave ANTHROPIC_API_KEY unset to run the mock provider (deterministic,
# no network) — every ai_* step still works, it just returns canned output.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# Set to 1 to run the browser headless. Default is headed: LinkedIn is markedly
# more suspicious of headless sessions, and you want to see what it is doing.
HEADLESS=0

# Global kill switch. Set to 1 and the scheduler refuses to run any action.
PAUSED=0
