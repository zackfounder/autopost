{
  "name": "social-media-automation-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An AI agent that runs your LinkedIn through a real browser you are already logged into: posts, comments, reactions, reposts, replies to your own comment threads, invitations and DMs. No platform API keys, self-hosted, free LLM tier.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "setup": "tsx scripts/setup-web.ts",
    "setup:cli": "tsx scripts/setup.ts",
    "doctor": "tsx scripts/doctor.ts",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx scripts/init-db.ts",
    "login": "tsx scripts/login.ts",
    "campaign": "tsx scripts/campaign.ts",
    "leads": "tsx scripts/leads.ts",
    "schedule": "tsx scripts/schedule.ts",
    "accounts": "tsx scripts/accounts.ts",
    "start": "tsx src/server/index.ts",
    "dev": "tsx watch src/server/index.ts",
    "mcp": "tsx src/mcp/server.ts",
    "smoke": "tsx scripts/smoke.ts",
    "selftest": "tsx scripts/selftest.ts",
    "draft": "WRITE_MODE=draft tsx scripts/write.ts",
    "queue": "WRITE_MODE=queue tsx scripts/write.ts",
    "publish": "WRITE_MODE=publish tsx scripts/write.ts",
    "postinstall": "playwright install chromium",
    "login:all": "tsx scripts/login-all.ts",
    "whoami": "tsx scripts/whoami.ts",
    "unlock:x": "tsx scripts/unlock-x.ts",
    "rail": "tsx scripts/rail.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "csv-parse": "^7.0.1",
    "dotenv": "^16.4.5",
    "playwright": "^1.50.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
